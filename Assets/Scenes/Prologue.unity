--- !u!114 &763943071
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 763943070}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12de113f82bbca84583569c8820fde32, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PrologueController
  dialogManager: {fileID: 763943072}
  dialogueMessages:
  - text: "(\uC5B4\uB450\uC6B4 \uD654\uBA74\uC5D0\uC11C \uD560\uBA38\uB2C8\uC758
      \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4)"
    image: {fileID: 0}
  - text: "\uC61B\uB0A0 \uC61B\uC801, \uC544\uC8FC \uBA3C \uC61B\uB0A0\uC5D0..."
    image: {fileID: 0}
  - text: "\uC0AC\uB78C\uB4E4\uC758 \uC18C\uC6D0\uC744 \uC774\uB8E8\uC5B4 \uC900\uB2E4\uB294
      \uC2E0\uBE44\uB85C\uC6B4 \uBCC4\uC774 \uC788\uC5C8\uB2E8\uB2E4"
    image: {fileID: 9088594088753746190, guid: c9869d7c71f3ea94686b3866662aeff2, type: 3}
  - text: "\uADF8 \uBCC4\uC758 \uC774\uB984\uC740 \uC18C\uC6D0\uC758 \uD61C\uC131"
    image: {fileID: 0}
  - text: "\uBB34\uB824 726\uB144\uB9C8\uB2E4 \uB2E8 \uD55C \uBC88, \uBC24\uD558\uB298\uC5D0
      \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0B8\uB2E4\uACE0 \uD558\uC9C0"
    image: {fileID: 0}
  - text: "\uC804\uD574\uC9C0\uB294 \uC774\uC57C\uAE30\uC5D0 \uB530\uB974\uBA74 \uADF8
      \uD61C\uC131\uC5D0 \uB3C4\uB2EC\uD55C \uC0AC\uB78C\uC740..."
    image: {fileID: 0}
  - text: "\uC790\uC2E0\uC774 \uAC04\uC808\uD788 \uBC14\uB77C\uB358 \uC18C\uC6D0
      \uD558\uB098\uB97C \uC774\uB8F0 \uC218 \uC788\uB2E4\uACE0 \uD574"
    image: {fileID: 0}
  - text: "\uADF8 \uC18C\uBB38\uC744 \uB4E4\uC740 \uC0AC\uB78C\uB4E4\uC740 \uC800\uB9C8\uB2E4\uC758
      \uC18C\uC6D0\uC744 \uD488\uAE30 \uC2DC\uC791\uD588\uC5B4"
    image: {fileID: 7287996661359254539, guid: 3ff8a263da6c0ef4186b541242b41195, type: 3}
  - text: "\uB204\uAD70\uAC00\uB294 \uC138\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uAC15\uD55C
      \uC0AC\uB78C\uC774 \uB418\uACE0 \uC2F6\uC5B4 \uD588\uACE0..."
    image: {fileID: 0}
  - text: "\uBD80\uC640 \uBA85\uC608\uB97C \uC5BB\uACE0 \uC2F6\uC5B4 \uD588\uC9C0"
    image: {fileID: 0}
  - text: "\uB610 \uB204\uAD70\uAC00\uB294 \uC18C\uC911\uD55C \uC0AC\uB78C\uC744
      \uB2E4\uC2DC \uB9CC\uB098\uACE0 \uC2F6\uC5B4 \uD588\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uC0AC\uB78C\uB4E4\uC758 \uC18C\uC6D0\uC740 \uBAA8\uB450 \uB2EC\uB790\uC9C0\uB9CC... "
    image: {fileID: 0}
  - text: "\uADF8 \uB9C8\uC74C\uB9CC\uD07C\uC740 \uB204\uAD6C\uBCF4\uB2E4 \uAC04\uC808\uD588\uC5B4"
    image: {fileID: 0}
  - text: "\uD558\uC9C0\uB9CC \uC2DC\uAC04\uC774 \uD750\uB974\uBA74\uC11C \uC0AC\uB78C\uB4E4\uC758
      \uB9C8\uC74C\uB3C4 \uBCC0\uD558\uAE30 \uC2DC\uC791\uD588\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uCC98\uC74C\uC5D0\uB294 \uADF8\uC800 \uC790\uC2E0\uC758 \uC18C\uC6D0\uC744
      \uC774\uB8E8\uACE0 \uC2F6\uC5C8\uC744 \uBFD0\uC774\uC5C8\uB294\uB370..."
    image: {fileID: 0}
  - text: "\uB204\uAD70\uAC00\uB294 \uB0A8\uB4E4\uBCF4\uB2E4 \uBA3C\uC800 \uD61C\uC131\uC5D0
      \uB3C4\uB2EC\uD558\uB824 \uD588\uACE0"
    image: {fileID: 0}
  - text: "\uB2E4\uB978 \uC0AC\uB78C\uC774 \uC18C\uC6D0\uC744 \uC774\uB8E8\uB294
      \uAC83\uC870\uCC28 \uBC14\uB77C\uC9C0 \uC54A\uC558\uC9C0"
    image: {fileID: 0}
  - text: "\uACB0\uAD6D \uC0AC\uB78C\uB4E4\uC740 \uC11C\uB85C\uB97C \uACBD\uACC4\uD558\uACE0,
      \uB2E4\uD22C\uAE30 \uC2DC\uC791\uD588\uC5B4"
    image: {fileID: 6140944763972783717, guid: 39a8e9ab9586e9945b453543b6050c62, type: 3}
  - text: "\uC790\uC2E0\uC758 \uC18C\uC6D0\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC758
      \uC18C\uC6D0\uBCF4\uB2E4 \uB354 \uC911\uC694\uD558\uB2E4\uACE0 \uBBFF\uC73C\uBA74\uC11C
      \uB9D0\uC774\uC57C"
    image: {fileID: 0}
  - text: "\uC0AC\uB78C\uB4E4\uC740 \uC11C\uB85C\uC758 \uD798\uC744 \uACA8\uB8E8\uBA70
      \uC790\uC2E0\uC758 \uAFC8\uC744 \uC99D\uBA85\uD558\uB824 \uD588\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uCC98\uC74C\uC5D0\uB294 \uD61C\uC131\uC744 \uCC28\uC9C0\uD558\uAE30 \uC704\uD55C
      \uC2F8\uC6C0\uC774\uC5C8\uC9C0\uB9CC... "
    image: {fileID: 0}
  - text: "\uC138\uC6D4\uC774 \uD750\uB974\uBA74\uC11C \uC2B9\uBD80\uB294 \uC0AC\uB78C\uB4E4\uC758
      \uC0B6 \uC18D\uC5D0 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uC790\uB9AC \uC7A1\uC558\uC5B4"
    image: {fileID: 0}
  - text: "\uC774\uC81C\uB294 \uD61C\uC131\uC5D0 \uAD00\uC2EC\uC774 \uC5C6\uB294
      \uC0AC\uB78C\uB4E4\uB3C4 \uC800\uB9C8\uB2E4\uC758 \uBAA9\uD45C\uB97C \uC704\uD574
      \uC2B9\uBD80\uB97C \uACA8\uB8E8\uACE4 \uD558\uC9C0"
    image: {fileID: -581299293732732331, guid: 1a2adb16e127b0543b3c0eef7849da85, type: 3}
  - text: "\uB204\uAD70\uAC00\uB294 \uB354 \uAC15\uD574\uC9C0\uAE30 \uC704\uD574"
    image: {fileID: 0}
  - text: "\uB2E4\uB978 \uB204\uAD70\uAC00\uB294 \uC790\uC2E0\uC758 \uC2E4\uB825\uC744
      \uC778\uC815\uBC1B\uAE30 \uC704\uD574"
    image: {fileID: 0}
  - text: "\uB610 \uB2E4\uB978 \uB204\uAD70\uAC00\uB294 \uC18C\uC911\uD55C \uAFC8\uC744
      \uC9C0\uD0A4\uAE30 \uC704\uD574\uC11C \uB9D0\uC774\uC57C"
    image: {fileID: 0}
  - text: "\uADF8\uB807\uAC8C \uC774 \uC138\uC0C1\uC5D0\uC11C\uB294 \uC624\uB298\uB3C4
      \uC218\uB9CE\uC740 \uC2B9\uBD80\uAC00 \uD3BC\uCCD0\uC9C0\uACE0 \uC788\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uC790, \uC624\uB298 \uC774\uC57C\uAE30\uB294 \uC5EC\uAE30\uAE4C\uC9C0\uB780\uB2E4"
    image: {fileID: -4062170327287573879, guid: 7400e021d5e123f4a81053e7c5556c31, type: 3}
  - text: "\uD6C4\uD6C4, \uC6B0\uB9AC \uAC15\uC544\uC9C0\uB294 \uC774 \uC774\uC57C\uAE30\uAC00
      \uADF8\uB807\uAC8C \uC88B\uC73C\uB2C8? "
    image: {fileID: 0}
  - text: "\uADF8\uB7F0\uB370 \uB9D0\uC774\uB2E4... "
    image: {fileID: 0}
  - text: "\uD560\uBA38\uB2C8\uB294 \uAC00\uB054 \uADF8\uB7F0 \uC0DD\uAC01\uC744
      \uD55C\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uC18C\uC6D0\uC744 \uC774\uB8E8\uB294 \uAC83\uB3C4 \uC88B\uC9C0\uB9CC... "
    image: {fileID: 0}
  - text: "\uADF8 \uC18C\uC6D0\uC744 \uC704\uD574 \uBB34\uC5C7\uC744 \uD558\uB294\uC9C0\uB3C4
      \uC911\uC694\uD558\uC9C0 \uC54A\uC744\uAE4C \uD558\uACE0 \uB9D0\uC774\uC57C"
    image: {fileID: 0}
  - text: "\uB2E4\uB978 \uC0AC\uB78C\uC758 \uAFC8\uC744 \uC9D3\uBC1F\uC73C\uBA74\uC11C\uAE4C\uC9C0
      \uC790\uC2E0\uC758 \uAFC8\uC744 \uC774\uB8E8\uC5B4\uC57C \uD55C\uB2E4\uBA74... "
    image: {fileID: 0}
  - text: "\uACFC\uC5F0 \uADF8 \uC18C\uC6D0\uC740 \uC815\uB9D0 \uD589\uBCF5\uD55C
      \uC18C\uC6D0\uC77C\uAE4C? "
    image: {fileID: 0}
  - text: "\uADF8\uB7FC \uC6B0\uB9AC \uAC15\uC544\uC9C0\uB294?"
    image: {fileID: 0}
  - text: "\uB098\uC911\uC5D0 \uCEE4\uC11C \uC5B4\uB5A4 \uAFC8\uC744 \uC774\uB8E8\uACE0
      \uC2F6\uB2C8? "
    image: {fileID: 0}
  - text: "\uADF8\uB807\uAD6C\uB098..."
    image: {fileID: 0}
  - text: "\uD6C4\uD6C4, \uAF2D \uC774\uB8F0 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uB124"
    image: {fileID: 0}
  - text: "\uD558\uC9C0\uB9CC \uC774\uAC83\uB9CC\uC740 \uAE30\uC5B5\uD558\uB834"
    image: {fileID: 0}
  - text: "\uC138\uC0C1\uC5D0 \uD558\uCC2E\uC740 \uAFC8\uC774\uB780 \uC5C6\uB2E8\uB2E4"
    image: {fileID: 0}
  - text: "\uB0A8\uB4E4\uC774 \uBB50\uB77C\uACE0 \uD558\uB4E0, \uB124\uAC00 \uC9C4\uC2EC\uC73C\uB85C
      \uC18C\uC911\uD788 \uC5EC\uAE30\uB294 \uAFC8\uC774\uB77C\uBA74... "
    image: {fileID: 0}
  - text: "\uB05D\uAE4C\uC9C0 \uD3EC\uAE30\uD558\uC9C0 \uB9D0\uACE0 \uC9C0\uCF1C
      \uB098\uAC00\uB834"
    image: {fileID: 0}
  - text: "\uD560\uBA38\uB2C8\uB294 \uC5B8\uC81C\uB098 \uB124 \uD3B8\uC774\uB2C8\uAE4C"
    image: {fileID: 0}
  backgroundImage: {fileID: 1069552475}
  imageFadeDuration: 2.5
  dialogFadeDuration: 0.3
  messages: []
  nextSceneName: PalletTown
  onCompleted:
    m_PersistentCalls:
      m_Calls: []
